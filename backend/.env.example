# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Backend Server Port (automatically set by hosting platforms like Render, Railway, etc.)
PORT=5000

# Optional: Restrict frontend CORS in production (e.g., https://your-frontend.vercel.app)
# If omitted or left blank, all origins are allowed.
# CLIENT_ORIGIN=https://your-frontend.vercel.app

